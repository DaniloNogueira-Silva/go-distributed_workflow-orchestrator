# Edge API Gateway
PORT=8080

# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Rate Limiter Settings (Inbound Token Bucket)
RATE_LIMIT_CAPACITY=5.0
RATE_LIMIT_REFILL_RATE=2.0

# PostgreSQL Configuration (for upcoming phases)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=orchestrator_db
DB_SSLMODE=disable
