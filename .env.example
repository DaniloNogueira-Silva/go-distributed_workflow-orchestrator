# Edge API Gateway
PORT=8080

# Isolated gRPC Domain Worker Addresses (4 separate servers/processes)
PAYMENT_WORKER_ADDR=localhost:50051
INVENTORY_WORKER_ADDR=localhost:50052
FULFILLMENT_WORKER_ADDR=localhost:50053
NOTIFICATION_WORKER_ADDR=localhost:50054

# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Inbound Rate Limiter Settings (Edge Gateway Token Bucket)
RATE_LIMIT_CAPACITY=5.0
RATE_LIMIT_REFILL_RATE=2.0

# Outbound Rate Limiter Settings (External APIs: Payment & Shipping Carrier)
OUTBOUND_RATE_LIMIT_CAPACITY=10.0
OUTBOUND_RATE_LIMIT_REFILL_RATE=30.0

# PostgreSQL Configuration (Event Sourcing & Domain Worker Tables)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=orchestrator_db
DB_SSLMODE=disable
