# Edge API Gateway & gRPC Worker Server
PORT=8080
GRPC_ADDR=localhost:50051

# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# Inbound Rate Limiter Settings (Edge Gateway Token Bucket)
RATE_LIMIT_CAPACITY=5.0
RATE_LIMIT_REFILL_RATE=2.0

# Outbound Rate Limiter Settings (External APIs: Payment & Shipping Carrier)
OUTBOUND_RATE_LIMIT_CAPACITY=2.0
OUTBOUND_RATE_LIMIT_REFILL_RATE=5.0

# PostgreSQL Configuration (Event Sourcing Store)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=orchestrator_db
DB_SSLMODE=disable
